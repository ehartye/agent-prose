{
  "schema": "prose/lexicon@1",
  "id": "ai-tells",
  "sources": ["wikipedia-signs-ai"],
  "reviewed": "2026-10-03",
  "note": "Era-tagged vocabulary, structural tells and chatbot artifacts. Style findings, never authorship verdicts. 'key', 'landscape' and 'valuable' are omitted because their literal uses are too common to flag.",
  "entries": [
    { "id": "additionally", "pattern": "(?:^|[.!?]\\s+)additionally\\b", "tier": "vocabulary", "eras": ["gpt-4"] },
    { "id": "boasts", "pattern": "\\bboasts?\\b", "tier": "vocabulary", "eras": ["gpt-4"] },
    { "id": "bolstered", "pattern": "\\bbolstered\\b", "tier": "vocabulary", "eras": ["gpt-4", "gpt-4o"] },
    { "id": "crucial", "pattern": "\\bcrucial\\b", "tier": "vocabulary", "eras": ["gpt-4", "gpt-4o"] },
    { "id": "delve", "pattern": "\\bdelv(?:e|es|ed|ing)\\b", "tier": "vocabulary", "eras": ["gpt-4"] },
    { "id": "emphasizing", "pattern": "\\bemphasi[sz]ing\\b", "tier": "vocabulary", "eras": ["gpt-4", "gpt-4o", "gpt-5"] },
    { "id": "enduring", "pattern": "\\benduring\\b", "tier": "vocabulary", "eras": ["gpt-4", "gpt-4o"] },
    { "id": "garner", "pattern": "\\bgarner(?:s|ed|ing)?\\b", "tier": "vocabulary", "eras": ["gpt-4"] },
    { "id": "intricate", "pattern": "\\bintrica(?:te|cies)\\b", "tier": "vocabulary", "eras": ["gpt-4"] },
    { "id": "interplay", "pattern": "\\binterplay\\b", "tier": "vocabulary", "eras": ["gpt-4"] },
    { "id": "meticulous", "pattern": "\\bmeticulous(?:ly)?\\b", "tier": "vocabulary", "eras": ["gpt-4"] },
    { "id": "pivotal", "pattern": "\\bpivotal\\b", "tier": "vocabulary", "eras": ["gpt-4", "gpt-4o"] },
    { "id": "underscore", "pattern": "\\bunderscor(?:e|es|ed|ing)\\b", "tier": "vocabulary", "eras": ["gpt-4", "gpt-4o"] },
    { "id": "tapestry", "pattern": "\\btapestr(?:y|ies)\\b", "tier": "vocabulary", "eras": ["gpt-4"] },
    { "id": "testament", "pattern": "\\btestament\\b", "tier": "vocabulary", "eras": ["gpt-4"] },
    { "id": "vibrant", "pattern": "\\bvibrant\\b", "tier": "vocabulary", "eras": ["gpt-4", "gpt-4o"] },
    { "id": "align-with", "pattern": "\\balign(?:s|ed|ing)?\\s+with\\b", "tier": "vocabulary", "eras": ["gpt-4o"] },
    { "id": "enhance", "pattern": "\\benhanc(?:e|es|ed|ing)\\b", "tier": "vocabulary", "eras": ["gpt-4o", "gpt-5"] },
    { "id": "fostering", "pattern": "\\bfostering\\b", "tier": "vocabulary", "eras": ["gpt-4o"] },
    { "id": "highlighting", "pattern": "\\bhighlighting\\b", "tier": "vocabulary", "eras": ["gpt-4o", "gpt-5"] },
    { "id": "showcasing", "pattern": "\\bshowcasing\\b", "tier": "vocabulary", "eras": ["gpt-4o", "gpt-5"] },
    { "id": "copula-avoidance", "pattern": "\\b(?:serves|stands|functions|operates)\\s+as(?=\\s+(?:a|an|the)\\b)", "tier": "structure" },
    { "id": "negative-parallelism", "pattern": "\\bnot\\s+(?:only|just)\\b[^.!?]{1,80}?\\bbut\\b", "tier": "structure" },
    { "id": "important-to-note", "pattern": "\\bit(?:['’]s| is) important to note\\b", "tier": "structure" },
    { "id": "oaicite", "pattern": "contentReference\\[oaicite:\\d+\\](?:\\{[^}]*\\})?|oai_citation|oaicite", "tier": "artifact" },
    { "id": "turn0search", "pattern": "turn\\d+search\\d+|attributableIndex", "tier": "artifact" },
    { "id": "gemini-cite", "pattern": "\\[cite:\\s*\\d+\\]", "tier": "artifact" },
    { "id": "grok-card", "pattern": "grok_card", "tier": "artifact" },
    { "id": "utm-chatgpt", "pattern": "utm_source=chatgpt\\.com", "tier": "artifact" },
    { "id": "utm-ai-assistant", "pattern": "utm_source=(?:openai|copilot\\.com)\\b|referrer=grok\\.com", "tier": "artifact" },
    { "id": "insert-source-url", "pattern": "\\bINSERT_SOURCE_URL\\b", "tier": "artifact" },
    { "id": "placeholder", "pattern": "\\[Your Name\\]|\\b\\d{4}-XX-XX\\b", "tier": "artifact" },
    { "id": "unfilled-bracket", "pattern": "\\[INSERT [^\\]\\n]{1,60}\\]|\\[Company Name\\]|\\[Your [^\\]\\n]{1,40}\\]", "tier": "artifact" },
    { "id": "template-variable", "pattern": "\\{\\{\\s*[A-Za-z_][\\w.-]{0,40}\\s*\\}\\}", "tier": "artifact" },
    { "id": "profound", "pattern": "\\bprofound(?:ly)?\\b", "tier": "promotional" },
    { "id": "exemplifies", "pattern": "\\bexemplif(?:y|ies|ied)\\b", "tier": "promotional" },
    { "id": "commitment-to", "pattern": "\\bcommitment to\\b", "tier": "promotional" },
    { "id": "nestled", "pattern": "\\bnestled\\b", "tier": "promotional" },
    { "id": "in-the-heart-of", "pattern": "\\bin the heart of\\b", "tier": "promotional" },
    { "id": "groundbreaking", "pattern": "\\bgroundbreaking\\b", "tier": "promotional" },
    { "id": "renowned", "pattern": "\\brenowned\\b", "tier": "promotional" },
    { "id": "diverse-array", "pattern": "\\bdiverse array\\b", "tier": "promotional" }
  ]
}
